# Local agent API key for /api/v1/*
API_KEY=dev-local-key

# Keep in sync with src/lib/constants.ts APP_PORT
PORT=1314


# TikHub (WeChat / Baidu / Google search for agent webSearch tools)
TIKHUB_API_KEY=

# Optional isolated Codex home for Progress Agent (default: ~/.progress/codex)
PROGRESS_CODEX_HOME=

# Optional proxy used by the integrated Hot Radar Reddit fetcher.
REDDIT_PROXY=
